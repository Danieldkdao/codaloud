{
  "expo": {
    "name": "codaloud",
    "slug": "codaloud",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/codaloud-icon.png",
    "scheme": "codaloud",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/codaloud.icon",
      "bundleIdentifier": "com.codaloud.development"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E0E7DC",
        "foregroundImage": "./assets/logo.png",
        "monochromeImage": "./assets/logo.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.codaloud.development"
    },
    "platforms": ["ios", "android"],
    "web": {
      "output": "server"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "@livekit/react-native-expo-plugin",
        {
          "android": {
            "audioType": "communication",
            "enableScreenShareService": false
          }
        }
      ],
      [
        "@config-plugins/react-native-webrtc",
        {
          "microphonePermission": "Allow Codaloud to hear you during voice conversations."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#E0E7DC",
          "image": "./assets/logo.png",
          "imageWidth": 240,
          "resizeMode": "contain"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "enableSceneSupport": true
          }
        }
      ],
      "expo-sqlite",
      "./scripts/with-local-workspace.cjs"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
