  "scripts": {
    "start": "expo start",
    "dev": "node scripts/dev-with-voice.mjs",
    "dev:app": "expo start -c",
    "voice:dev": "node --env-file=.env --import tsx src/services/livekit/voice-worker.ts start",
    "voice:start": "node --import tsx src/services/livekit/voice-worker.ts start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "node scripts/dev-with-voice.mjs run:android",
    "ios": "node scripts/dev-with-voice.mjs run:ios --device",
    "export:api": "EXPO_NO_WEB_SETUP=1 expo export --platform web --api-only",
    "lint": "expo lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate:icons": "node scripts/generate-material-icons.mjs",
    "check:icons": "node scripts/generate-material-icons.mjs --check",
    "db:generate:cloud": "drizzle-kit generate --config drizzle-cloud.config.ts",
    "db:generate:local": "drizzle-kit generate --config drizzle-local.config.ts",
    "db:migrate:cloud": "drizzle-kit migrate --config drizzle-cloud.config.ts",
    "db:auth": "pnpm dlx auth@latest generate --config ./src/lib/auth/auth.ts --output ./src/db/cloud/schemas/new-user.ts --yes",
    "generate:typescript": "node scripts/build-local-typescript.mjs",
    "prestart": "node scripts/build-local-typescript.mjs",
    "pretest": "node scripts/build-local-typescript.mjs && node scripts/build-local-workspace-host.mjs",
    "prepare:native": "node scripts/prepare-local-workspace.mjs",
    "build:native:ios": "node scripts/build-local-workspace-ios.mjs",
    "build:native:host": "node scripts/build-local-workspace-host.mjs",
    "postinstall": "node scripts/build-local-typescript.mjs && node scripts/prepare-local-workspace.mjs",
    "preios": "node scripts/build-local-typescript.mjs && node scripts/build-local-workspace-ios.mjs",
    "preandroid": "node scripts/build-local-typescript.mjs && node scripts/prepare-local-workspace.mjs",
    "update:native": "node scripts/update-native-dependencies.mjs",
    "configure:native-editor": "node scripts/configure-native-editor.mjs",
    "tasks:dev": "trigger dev",
    "tasks:deploy": "trigger deploy"
  },
  "private": true,
  "packageManager": "pnpm@12.6.0"
}
