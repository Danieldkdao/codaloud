{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "types": ["expo/types"],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/assets/*": [
        "./assets/*"
      ]
    }
  },
  "noUnusedLocals": true,
  "noUnusedParameters": true,
  "allowUnusedLabels": false,
  "noUncheckedSideEffectImports": true,
  "noFallthroughCasesInSwitch": true,
  "allowUnreachableCode": false,
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "nativewind-env.d.ts"
  ]
}
